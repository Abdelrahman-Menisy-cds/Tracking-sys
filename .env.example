# Copy to .env for local-only secrets. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# Explicit local HTTP-only override; leave disabled for Secure cookies.
# DJANGO_ALLOW_INSECURE_COOKIES=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# PostgreSQL (approved DB; tests run on SQLite via DJANGO_USE_SQLITE=1)
POSTGRES_DB=heya_fawda_dev
POSTGRES_USER=heya_fawda
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Set to 1 to force the SQLite fallback (also used automatically by pytest)
# DJANGO_USE_SQLITE=1

# --- LLM provider: OpenCode Go -------------------------------------------------
# Server-side only. Read by Django from the process environment. Do NOT copy this
# into the frontend and do NOT prefix it with VITE_ — the frontend bundle is
# public and any VITE_* value is inlined into it verbatim.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=glm-5.3-flash

# glm-5.3-flash reasons before it answers and the reasoning tokens come out of
# max_tokens, so a small budget returns content=null ("reasoning budget
# exhausted"). Measured on the Islamic-holiday proposal prompt for 2026/EG:
# 1500/4000 -> empty answer; 8000 -> a full correct answer in ~152s. The timeout
# must clear that, or the request is aborted mid-answer and reported as "the
# provider is unavailable" when it was really "we hung up on it".
# OPENCODE_GO_MIN_TOKENS=8000
# OPENCODE_GO_RETRY_TOKENS=16000
# OPENCODE_GO_TIMEOUT_SECONDS=300
