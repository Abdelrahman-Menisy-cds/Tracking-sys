# Copy to .env for local-only secrets. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# Explicit local HTTP-only override; leave disabled for Secure cookies.
# DJANGO_ALLOW_INSECURE_COOKIES=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# PostgreSQL (approved DB; tests run on SQLite via DJANGO_USE_SQLITE=1)
POSTGRES_DB=heya_fawda_dev
POSTGRES_USER=heya_fawda
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Set to 1 to force the SQLite fallback (also used automatically by pytest)
# DJANGO_USE_SQLITE=1
